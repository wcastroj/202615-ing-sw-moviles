<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_description"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rating label -->
        <TextView
            android:id="@+id/tvRatingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_comment_rating_label"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbRating1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_1"
                android:textColor="#1C1B1F"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbRating2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_2"
                android:textColor="#1C1B1F"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbRating3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_3"
                android:textColor="#1C1B1F"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbRating4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_4"
                android:textColor="#1C1B1F"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbRating5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_5"
                android:textColor="#1C1B1F"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- Comment input -->
        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="none"
            android:background="@drawable/bg_description"
            android:gravity="top"
            android:hint="@string/add_comment_placeholder"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="#1C1B1F"
            android:textColorHint="#938F96"
            android:textSize="14sp" />

        <!-- Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B00020"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Por favor ingresa un comentario mayor a 1 carácter." />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Button -->
        <com.example.vinyls_application.ui.widgets.ButtonWidget
            android:id="@+id/btnSubmitComment"
            style="@style/ButtonPrimaryStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:customText="@string/add_comment_submit_button"
            app:hasIcon="false" />

    </LinearLayout>

</merge>