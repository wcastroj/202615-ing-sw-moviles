<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:gravity="center_vertical"
    tools:minHeight="56dp"
    tools:orientation="horizontal"
    tools:paddingBottom="8dp"
    tools:paddingTop="8dp"
    tools:parentTag="android.widget.LinearLayout">

    <!-- Return -->
    <ImageButton
        android:id="@+id/btnReturn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_header_return"
        android:contentDescription="@string/header_return"
        android:elevation="3dp"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:tint="#1E1E1E"
        tools:visibility="visible" />

    <!-- Header -->
    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#1E1E1E"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Detalle del Álbum" />

</merge>
