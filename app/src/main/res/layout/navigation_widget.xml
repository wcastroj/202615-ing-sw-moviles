<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/bg_navigation_widget"
    android:elevation="8dp"
    app:itemIconSize="20dp"
    app:itemIconTint="@color/navigation_widget_item_color"
    app:itemRippleColor="#33FFFFFF"
    app:itemTextAppearanceActive="@style/NavigationWidget.TextActive"
    app:itemTextAppearanceInactive="@style/NavigationWidget.Text"
    app:itemTextColor="@color/navigation_widget_item_color"
    app:labelVisibilityMode="labeled"
    app:menu="@menu/navigation_widget_menu" />

