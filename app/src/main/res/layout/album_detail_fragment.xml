<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- NestedScrollView solo admite un hijo directo: el contenido -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.example.vinyls_application.ui.widgets.DetailCardWidget
            android:id="@+id/detail_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Botón Asociar canción -->
        <com.example.vinyls_application.ui.widgets.ButtonWidget
            android:id="@+id/buttonAssociateTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/ButtonPrimaryStyle"
            app:customText="Asociar canción"
            app:hasIcon="true" />

        <!-- Canciones Relacionadas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canciones relacionadas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <com.example.vinyls_application.ui.widgets.SummaryListWidget
            android:id="@+id/tracksListWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Artistas Relacionados -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artistas relacionados"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <com.example.vinyls_application.ui.widgets.SummaryListWidget
            android:id="@+id/performersListWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.vinyls_application.ui.widgets.CommentsListWidget
            android:id="@+id/comments_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ================= ERROR VIEW (¡Ups! Algo se desafinó...) ================= -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- InformationWidget -->
        <com.example.vinyls_application.ui.widgets.InformationWidget
            android:id="@+id/errorInformationWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>