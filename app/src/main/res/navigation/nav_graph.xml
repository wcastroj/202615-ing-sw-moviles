<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.vinyls_application.ui.LoginFragment"
        android:label="Vivo Sonika"
        tools:layout="@layout/login_fragment">
        <action
            android:id="@+id/action_loginFragment_to_albumFragment"
            app:destination="@id/albumFragment" />
    </fragment>

    <fragment
        android:id="@+id/albumFragment"
        android:name="com.example.vinyls_application.ui.AlbumFragment"
        android:label="@string/header_home"
        tools:layout="@layout/album_fragment">
        <action
            android:id="@+id/action_albumFragment_to_detailFragment"
            app:destination="@id/albumDetailFragment" />
    </fragment>



    <!-- El id coincide con el ítem "Artistas" de navigation_widget_menu.xml para que la barra inferior navegue aquí -->
    <fragment
        android:id="@+id/navigation_artists"
        android:name="com.example.vinyls_application.ui.PerformerFragment"
        android:label="@string/header_home"
        tools:layout="@layout/performer_fragment" />

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="com.example.vinyls_application.ui.AlbumDetailFragment"
        android:label="@string/title_album_detail"
        tools:layout="@layout/album_detail_fragment">

        <argument
            android:name="albumId"
            app:argType="integer" />
    </fragment>

</navigation>