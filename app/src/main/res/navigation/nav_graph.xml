<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.vinyls_application.ui.LoginFragment"
        android:label="Vivo Sonika"
        tools:layout="@layout/login_fragment">
        <action
            android:id="@+id/action_loginFragment_to_albumFragment"
            app:destination="@id/albumFragment" />
    </fragment>

    <fragment
        android:id="@+id/albumFragment"
        android:name="com.example.vinyls_application.ui.AlbumFragment"
        android:label="@string/header_home"
        tools:layout="@layout/album_fragment">
        <action
            android:id="@+id/action_albumFragment_to_detailFragment"
            app:destination="@id/albumDetailFragment" />
        <action
            android:id="@+id/action_albumFragment_to_albumCreateFragment"
            app:destination="@id/albumCreateFragment" />
        <action
            android:id="@+id/action_albumFragment_to_collectorFragment"
            app:destination="@id/navigation_collectors" />
    </fragment>

    <fragment
        android:id="@+id/albumCreateFragment"
        android:name="com.example.vinyls_application.ui.AlbumCreateFragment"
        android:label="@string/album_create_title"
        tools:layout="@layout/album_create_fragment" />



    <!-- El id coincide con el ítem "Artistas" de navigation_widget_menu.xml para que la barra inferior navegue aquí -->
    <fragment
        android:id="@+id/navigation_artists"
        android:name="com.example.vinyls_application.ui.PerformerFragment"
        android:label="@string/header_home"
        tools:layout="@layout/performer_fragment">

        <action
            android:id="@+id/action_performerFragment_to_performerDetailFragment"
            app:destination="@id/performerDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/navigation_collectors"
        android:name="com.example.vinyls_application.ui.CollectorFragment"
        android:label="@string/header_home"
        tools:layout="@layout/collector_fragment" />

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="com.example.vinyls_application.ui.AlbumDetailFragment"
        android:label="@string/title_album_detail"
        tools:layout="@layout/album_detail_fragment">

        <argument
            android:name="albumId"
            app:argType="integer" />
        <action
            android:id="@+id/action_albumDetailFragment_to_associateTrackFragment"
            app:destination="@id/associateTrackFragment" />
    </fragment>

    <fragment
        android:id="@+id/associateTrackFragment"
        android:name="com.example.vinyls_application.ui.AssociateTrackFragment"
        android:label="@string/associate_track_title"
        tools:layout="@layout/associate_track_fragment">

        <argument
            android:name="albumId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/performerDetailFragment"
        android:name="com.example.vinyls_application.ui.PerformerDetailFragment"
        android:label="Detalle del Artista"
        tools:layout="@layout/performer_detail_fragment">

        <argument
            android:name="id"
            app:argType="integer" />
        <argument
            android:name="type"
            app:argType="com.example.vinyls_application.models.PerformerType" />

        <action
            android:id="@+id/action_performerDetailFragment_to_associateAlbumFragment"
            app:destination="@id/associateAlbumFragment" />
    </fragment>

    <fragment
        android:id="@+id/associateAlbumFragment"
        android:name="com.example.vinyls_application.ui.AssociateAlbumFragment"
        android:label="Asociar Álbum"
        tools:layout="@layout/associate_album_fragment">

        <argument
            android:name="id"
            app:argType="integer" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="type"
            app:argType="com.example.vinyls_application.models.PerformerType" />
    </fragment>

</navigation>