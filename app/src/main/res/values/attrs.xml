<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="customText" format="string" />
    <attr name="hasIcon" format="boolean" />
    <attr name="customIcon" format="reference" />

    <declare-styleable name="ButtonWidget">
        <attr name="customText" />
        <attr name="hasIcon" />
        <attr name="customIcon" />
    </declare-styleable>

    <declare-styleable name="CatalogListWidget">
        <!-- grid: cuadrícula de CatalogCardWidget (por defecto); list: lista de CatalogRowWidget -->
        <attr name="catalogMode" format="enum">
            <enum name="grid" value="0" />
            <enum name="list" value="1" />
        </attr>
    </declare-styleable>
</resources>