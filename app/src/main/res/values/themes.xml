<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vinyls_Jetpack_Application" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:statusBarColor" >?attr/colorSecondaryVariant</item>
        <item name="android:windowBackground">@drawable/bg_app_transversal</item>
    </style>

    <style name="Theme.Vinyls_Jetpack_Application.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/bg_app_transversal</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ButtonPrimaryStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#7C3AED</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>

        <item name="android:elevation">20dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">#5729A6</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">#5729A6</item>

        <item name="android:paddingTop">19dp</item>
        <item name="android:paddingBottom">19dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
  
    <style name="ThemeOverlay.Vinyls.AlbumForm" parent="">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorOnSurface">#1C1B1F</item>
    </style>

    <style name="ThemeOverlay.Vinyls.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="FormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#1C1B1F</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1C1B1F</item>
        <item name="android:textColorHint">#938F96</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- errorEnabled reserva el espacio del mensaje: el formulario no salta al aparecer un error -->
    <style name="FormField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="FormField.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="NavigationWidget.Text" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize" tools:ignore="SpUsage">12dp</item>
    </style>

    <style name="NavigationWidget.TextActive" parent="NavigationWidget.Text">
        <item name="android:textStyle">bold</item>
    </style>
</resources>