<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FDF7FF" />
    </item>

    <item
        android:gravity="top|right"
        android:top="-70dp"
        android:right="-70dp">
        <shape android:shape="oval">
            <size
                android:width="340dp"
                android:height="340dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#E6D3FA"
                android:centerColor="#80E6D3FA"
                android:endColor="#00FDF7FF" />
        </shape>
    </item>

    <item
        android:gravity="center_vertical|left"
        android:left="-100dp">
        <shape android:shape="oval">
            <size
                android:width="360dp"
                android:height="360dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#E6D3FA"
                android:centerColor="#80E6D3FA"
                android:endColor="#00FDF7FF" />
        </shape>
    </item>
</layer-list>
